<script>
  /* ⚠️ Для изменения списка заданий правьте ТОЛЬКО этот массив.
     num — номер задания, id — id варианта на inf-ege.sdamgia.ru */
  const TASKS = [
    { num: 1,  id: '21143910' },
    { num: 2,  id: '21143916' },
    { num: 3,  id: '21143921' },
    { num: 4,  id: '21143923' },
    { num: 5,  id: '21143931' },
    { num: 6,  id: '21143950' },
    { num: 7,  id: '21143962' },
    { num: 8,  id: '21143977' },
    { num: 9,  id: '21143995' },
    { num: 11, id: '21143996' },
  ];

  const arrow = `
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6"/>
    </svg>`;

  document.getElementById('task-list').innerHTML = TASKS.map((t, i) => `
    <div class="task-row" style="animation-delay:${i * 45}ms">
      <a class="task-btn"
         href="https://inf-ege.sdamgia.ru/test?id=${t.id}"
         target="_blank" rel="noopener noreferrer">
        Задание ${t.num} ${arrow}
      </a>
      <span class="variant">Вариант <b>№ ${t.id}</b></span>
    </div>
  `).join('');

  document.getElementById('count').textContent = TASKS.length + ' вариантов';
</script>
